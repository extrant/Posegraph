<Project Sdk="Dalamud.NET.SDK/15.0.0">

	<PropertyGroup>
		<Version>0.7.0.0</Version>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Description>Turn a photo or illustration into a Brio pose via a local AI backend.</Description>
	</PropertyGroup>

	<!-- 国服 XIVLauncherCN 的 Dalamud；不存在时 SDK 会回落到国际服默认路径 -->
	<PropertyGroup Condition="Exists('$(AppData)\XIVLauncherCN\addon\Hooks\dev\Dalamud.dll')">
		<DalamudLibPath>$(AppData)\XIVLauncherCN\addon\Hooks\dev\</DalamudLibPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Brio.API" Version="3.0.1" />
	</ItemGroup>

	<!-- 许可证随插件一起发布（DalamudPackager 会把输出目录里的文件打进 latest.zip） -->
	<ItemGroup>
		<None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
		<None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- 更新日志窗口的内容与横幅（横幅由 tools/UiPreview/make_banner.py 生成） -->
	<ItemGroup>
		<EmbeddedResource Include="Changelog\changelog.json" LogicalName="Posegraph.Changelog.changelog.json" />
		<EmbeddedResource Include="Changelog\banner.png" LogicalName="Posegraph.Changelog.banner.png" />
	</ItemGroup>

</Project>
